    },
    "Swipe a fit to delete it; touch and hold to rename, duplicate, upload or delete it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните оснастку, чтобы удалить её; коснитесь и удерживайте, чтобы переименовать, дублировать, загрузить или удалить её."
          }
        }
      }
    },
    "Swipe a hub to the left to remove it. A hub is a solar system: prices come from its region." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните хаб влево, чтобы удалить его. Хаб — это звёздная система: цены берутся из её сектора."
          }
        }
      }
    },
    "Swipe a label to delete it; its mail keeps its other labels. A label holds up to 40 characters and one of EVE’s 18 colours." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните метку, чтобы удалить её; другие метки писем сохранятся. В названии метки — до 40 символов, цвет — один из 18 цветов EVE."
          }
        }
      }
    },
    "Swipe a pilot left to remove it." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните пилота влево, чтобы удалить его."
          }
        }
      }
    },
    "Swipe a row left to reveal Remove; the tap on it is what removes." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смахните строку влево, чтобы появилась кнопка «Удалить»; удаляет нажатие на неё."
          }
        }
      }
    },
    "Switch values" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переключить значения"
          }
        }
      }
    },
    "Switches to the next state this module allows" : {
      "localizations" : {
        "ru" : {
