            "value" : "Значения"
          }
        }
      }
    },
    "Rolls are the item's attribute values, as in the game and ESI. Every change is saved with the fit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rolls sind die Attributwerte des Gegenstands, wie im Spiel und in ESI. Jede Änderung wird mit dem Fit gespeichert."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значения — это атрибуты предмета, как в игре и в ESI. Каждое изменение сохраняется в фите."
          }
        }
      }
    },
