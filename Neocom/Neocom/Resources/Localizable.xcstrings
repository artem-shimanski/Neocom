    "Taxes are the corporation’s share of members’ bounties and mission rewards, as booked in the Master Wallet journal. Members who paid nothing in the period are not listed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuern sind der Anteil der Corporation an den Kopfgeldern und Missionsbelohnungen der Mitglieder, wie im Journal der Hauptbrieftasche verbucht. Mitglieder, die im Zeitraum nichts gezahlt haben, werden nicht aufgeführt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налоги — доля корпорации от баунти и наград за миссии участников, как она записана в журнале главного кошелька. Участники, ничего не заплатившие за период, не показаны."
          }
        }
      }
    },
    "TE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TE"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TE"
          }
        }
      }
    },
    "Temperate" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gemäßigt"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Умеренная"
          }
        }
      }
    },
    "tf" : {
      "comment" : "Unit: teraflops (CPU)",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
