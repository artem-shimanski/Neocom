                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Очередь обучения закончится через %lld часа"
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Очередь обучения закончится через %lld часов"
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Очередь обучения закончится через %lld час"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Очередь обучения закончится через %lld часа"
                }
              }
            }
          }
        }
      }
    },
    "Training, planets and industry end at known times, so they are scheduled on this iPhone. Orders, contracts and mail need a check with EVE, which iOS runs in the background when it sees fit: those may come late." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обучение, планеты и промышленность заканчиваются в известное время, поэтому их уведомления планируются на этом iPhone. Заявки, контракты и почта требуют проверки в EVE, которую iOS запускает в фоне, когда сочтёт нужным: такие уведомления могут опаздывать."
          }
        }
      }
    },
    "Training, planets and industry end at known times, so they are scheduled on this Mac. Orders, contracts and mail need a check with EVE, which macOS lets Neocom make only now and then: those may come late." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обучение, планеты и промышленность заканчиваются в известное время, поэтому их уведомления планируются на этом Mac. Заявки, контракты и почта требуют проверки в EVE, которую macOS позволяет Neocom делать лишь время от времени: такие уведомления могут опаздывать."
          }
        }
      }
    },
