    "Rigs" : {
      "comment" : "EVE inventory flag name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifikationen"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модификаторы"
          }
        }
      }
    },
    "Rigs are always destroyed. Every other item either drops into the wreck or is destroyed, and a stack can split between the two. Values are estimates; the hull counts as destroyed. Open in Fitting Tool copies the lost fit into a new fit in My Fits." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifikationen werden immer zerstört. Jeder andere Gegenstand fällt entweder ins Wrack oder wird zerstört, und ein Stapel kann sich auf beides aufteilen. Die Werte sind Schätzungen; der Rumpf gilt als zerstört. „Im Fitting-Tool öffnen“ kopiert den verlorenen Fit in einen neuen Fit in „Meine Fits“."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Модификаторы уничтожаются всегда. Любой другой предмет либо выпадает в обломки, либо уничтожается, и стопка может разделиться между тем и другим. Стоимость — оценка; корпус считается уничтоженным. «Открыть в конструкторе оснастки» копирует потерянную оснастку в новую в «Моих оснастках»."
          }
        }
      }
    },
    "Rocket Speed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raketengeschw."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скор. НУР"
          }
        }
      }
    },
    "Rocket velocity" : {
      "localizations" : {
