          }
        }
      }
    },
    "A bid at the buyout price ends the auction at once. Otherwise the highest bid wins when it expires." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставка по цене выкупа сразу завершает аукцион. Иначе по истечении срока побеждает самая высокая ставка."
          }
        }
      }
    },
    "A buyer at %@ pays %@ more. Raise your price in the EVE client to be first again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A buyer at %1$@ pays %2$@ more. Raise your price in the EVE client to be first again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупатель (%@) платит на %@ больше. Поднимите цену в клиенте EVE, чтобы снова стать первым."
          }
        }
      }
    },
    "A charge does not fit its module: type %lld." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заряд не подходит к своему модулю: тип %lld."
          }
        }
      }
    },
    "A charge has no module in its slot: type %lld." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У заряда нет модуля в разъёме: тип %lld."
          }
        }
      }
    },
    "A drone could not be saved: type %u." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить дрона: тип %u."
          }
        }
      }
    },
    "A drone is added as a full stack of 5 and launched into space." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дрон добавляется полной стопкой из 5 штук и выпускается в космос."
          }
        }
      }
    },
    "A drone stack of %lld was reduced to %u: type %lld." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A drone stack of %1$lld was reduced to %2$u: type %3$lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стопка дронов уменьшена с %lld до %u: тип %lld."
          }
        }
      }
    },
    "A fighter is added as a full squadron and takes one slot of its type. It is launched into space while a fighter tube is free, and stays in the hangar otherwise." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истребитель добавляется полной эскадрильей и занимает один слот своего типа. Он выпускается в космос, пока есть свободная шахта истребителей, иначе остаётся в ангаре."
          }
        }
      }
    },
    "A fitting in EVE cannot tell drones in space from drones in the bay." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оснастка в EVE не различает дронов в космосе и в отсеке."
          }
        }
      }
    },
    "A fitting in EVE holds one ship: %lld other pilots not saved." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A fitting in EVE holds one ship: %lld other pilot not saved."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "A fitting in EVE holds one ship: %lld other pilots not saved."
                }
              }
            }
          }
        },
        "ru" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Оснастка в EVE вмещает один корабль: %lld других пилота не сохранены."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Оснастка в EVE вмещает один корабль: %lld других пилотов не сохранено."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Оснастка в EVE вмещает один корабль: %lld другой пилот не сохранён."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Оснастка в EVE вмещает один корабль: %lld других пилота не сохранены."
                }
              }
            }
          }
        }
      }
    },
    "A kill means %@ was among the attackers; a loss, that %@ was the victim." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A kill means %1$@ was among the attackers; a loss, that %2$@ was the victim."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уничтожение: %@ среди атакующих; потеря: %@ — жертва."
          }
        }
      }
    },
    "A kill means a %@ was among the attackers; a loss, that a %@ was destroyed." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A kill means a %1$@ was among the attackers; a loss, that a %2$@ was destroyed."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уничтожение: среди атакующих был корабль %@; потеря: был уничтожен корабль %@."
          }
        }
      }
    },
    "A kill means a ship of %@ was among the attackers; a loss, that one was destroyed." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уничтожение: среди атакующих был корабль группы «%@»; потеря: такой корабль был уничтожен."
          }
        }
      }
    },
    "A killmail ID opens that one killmail; filters do not apply to it. A zKillboard link pasted here works too." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По ID открывается один конкретный киллмейл, фильтры к нему не применяются. Можно вставить и ссылку zKillboard."
          }
        }
      }
    },
    "A level you already have." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже изученный уровень."
          }
        }
      }
    },
    "A seller at %@ is %@ cheaper. Lower your price in the EVE client to be first again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A seller at %1$@ is %2$@ cheaper. Lower your price in the EVE client to be first again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продавец (%@) дешевле на %@. Снизьте цену в клиенте EVE, чтобы снова стать первым."
          }
        }
      }
    },
    "A ship cannot be its own target. Range and the target's position are not modelled." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Корабль не может быть целью сам для себя. Дальность и положение цели не учитываются."
          }
        }
      }
    },
    "A stack bigger than the free bay or bandwidth can still be added; the editor shows it in red." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стопку больше свободного места в отсеке или пропускной способности всё равно можно добавить — редактор покажет её красным."
          }
        }
      }
    },
    "A strategic cruiser has no high, medium, low or drone slots until its subsystems are fitted. Fit a core, defensive, offensive and propulsion subsystem." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока не установлены подсистемы, у стратегического крейсера нет разъёмов большой, средней и малой мощности и места для дронов. Установите основную, оборонительную, атакующую и двигательную подсистемы."
          }
        }
      }
    },
    "A tactical mode is not part of a fitting in EVE: %lld modules not saved." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
