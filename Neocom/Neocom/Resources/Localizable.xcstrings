    "Notifications" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления"
          }
        }
      }
    },
    "Notifications are scheduled on this iPhone from each colony's forecast and rebuilt whenever fresh data arrives from EVE. Until you open a colony in game again, Neocom cannot know what you changed there, so a reminder may come for something you already fixed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen werden auf diesem iPhone anhand der Prognose jeder Kolonie geplant und neu erstellt, sobald frische Daten von EVE eintreffen. Solange Sie eine Kolonie nicht erneut im Spiel öffnen, weiß Neocom nicht, was Sie dort geändert haben, daher kann eine Erinnerung für etwas kommen, das Sie bereits behoben haben."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления планируются на этом iPhone по прогнозу каждой колонии и пересчитываются, когда из EVE приходят свежие данные. Пока вы снова не откроете колонию в игре, Neocom не знает, что вы там изменили, поэтому напоминание может прийти о том, что вы уже исправили."
          }
        }
      }
    },
    "Notifications are scheduled on this Mac from each colony's forecast and rebuilt whenever fresh data arrives from EVE. Until you open a colony in game again, Neocom cannot know what you changed there, so a reminder may come for something you already fixed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen werden auf diesem Mac anhand der Prognose jeder Kolonie geplant und neu erstellt, sobald frische Daten von EVE eintreffen. Solange Sie eine Kolonie nicht erneut im Spiel öffnen, weiß Neocom nicht, was Sie dort geändert haben, daher kann eine Erinnerung für etwas kommen, das Sie bereits behoben haben."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления планируются на этом Mac по прогнозу каждой колонии и пересчитываются, когда из EVE приходят свежие данные. Пока вы снова не откроете колонию в игре, Neocom не знает, что вы там изменили, поэтому может прийти напоминание о том, что вы уже исправили."
          }
        }
      }
    },
