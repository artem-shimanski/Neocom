    "These facilities went offline. The jobs resume by themselves when the facilities are back online." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Anlagen sind offline gegangen. Die Jobs werden von selbst fortgesetzt, sobald die Anlagen wieder online sind."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти объекты отключены. Работы возобновятся сами, когда объекты снова заработают."
          }
        }
      }
    },
    "They Ask For" : {
