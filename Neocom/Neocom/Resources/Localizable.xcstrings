    "Training queue ends in %lld hours" : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Training queue ends in %lld hour"
                }
              },
