          }
        }
      }
    },
    "Change region" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Region ändern"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет сектор"
          }
        }
      }
    },
    "Changes made in the game can take up to five minutes to appear here. Tap a fitting to open a copy of it; the copy is added to My Fits once you change or save it. Swipe a fitting to delete it from the game; touch and hold to copy it to My Fits right away." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Änderungen im Spiel können bis zu fünf Minuten brauchen, bis sie hier erscheinen. Tippen Sie auf ein Fitting, um eine Kopie davon zu öffnen; die Kopie wird zu „Meine Fits“ hinzugefügt, sobald Sie sie ändern oder sichern. Wischen Sie über ein Fitting, um es im Spiel zu löschen; halten Sie es gedrückt, um es sofort nach „Meine Fits“ zu kopieren."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изменения, сделанные в игре, могут появиться здесь в течение пяти минут. Коснитесь оснастки, чтобы открыть её копию; копия попадёт в «Мои оснастки», как только вы её измените или сохраните. Смахните оснастку, чтобы удалить её из игры; коснитесь и удерживайте, чтобы сразу скопировать её в «Мои оснастки»."
          }
        }
      }
    },
    "Changes the implants and boosters of the fit's pilot" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert die Implantate und Booster des Piloten des Fits"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет импланты и стимуляторы пилота оснастки"
          }
        }
      }
    },
    "Changes the skills the fit is calculated with" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändert die Skills, mit denen der Fit berechnet wird"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Меняет навыки, с которыми считается оснастка"
          }
        }
      }
    },
    "Changes the system effect the fit is calculated under" : {
      "localizations" : {
