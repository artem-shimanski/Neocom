    "The package was not delivered by %@. The %@ collateral went to %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Paket wurde nicht bis %1$@ geliefert. Die Kaution von %2$@ ging an %3$@."
