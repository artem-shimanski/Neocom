    "Yields come from the program set in game; the bars after now are the forecast. As of last update %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Ausbeuten stammen aus dem im Spiel festgelegten Programm; die Balken nach jetzt sind die Prognose. Stand der letzten Aktualisierung: %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добыча берётся из программы, заданной в игре; столбцы после текущего момента — прогноз. Последнее обновление: %@."
          }
        }
      }
    },
