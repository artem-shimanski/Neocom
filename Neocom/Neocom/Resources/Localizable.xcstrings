      }
    },
    "EVE did not take the mail. Your mail is kept as written — send it again when you are ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE hat die Mail nicht angenommen. Ihre Mail bleibt wie geschrieben erhalten – senden Sie sie erneut, wenn Sie bereit sind."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE не принял письмо. Текст сохранён как есть — отправьте его ещё раз, когда будете готовы."
          }
        }
      }
    },
    "EVE does not count unread mail per mailing list. Join or leave lists in the EVE client." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE zählt ungelesene Mails nicht pro Mailingliste. Listen im EVE-Client beitreten oder verlassen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE не считает непрочитанные письма в списках рассылки. Вступать в списки и выходить из них можно в клиенте EVE."
          }
        }
      }
    },
    "EVE keeps 30 days of wallet history; older entries are gone from ESI. The journal refreshes hourly. Tap a category to open the journal filtered to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE speichert 30 Tage Brieftaschenverlauf; ältere Einträge sind aus ESI verschwunden. Das Journal wird stündlich aktualisiert. Tippen Sie auf eine Kategorie, um das danach gefilterte Journal zu öffnen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE хранит историю кошелька за 30 дней; более старых записей в ESI нет. Журнал обновляется раз в час. Коснитесь категории, чтобы открыть журнал с этим фильтром."
          }
        }
      }
    },
    "EVE keeps your kills and losses for 90 days and refreshes the list every 5 minutes. ISK values are estimates from average market prices; EVE does not report a value for a killmail." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE speichert Ihre Kills und Verluste 90 Tage und aktualisiert die Liste alle 5 Minuten. ISK-Werte sind Schätzungen aus durchschnittlichen Marktpreisen; EVE meldet keinen Wert für eine Killmail."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE хранит ваши уничтожения и потери 90 дней и обновляет список каждые 5 минут. Стоимость в ISK — оценка по средним рыночным ценам: EVE не сообщает стоимость киллмейла."
          }
        }
      }
    },
    "EVE lists items at this place but does not say what it is. Its contents are shown as EVE reports them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE listet an diesem Ort Gegenstände auf, sagt aber nicht, was er ist. Der Inhalt wird so angezeigt, wie EVE ihn meldet."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE сообщает о предметах в этом месте, но не говорит, что это за место. Содержимое показано так, как его передаёт EVE."
          }
        }
      }
    },
    "EVE offers these 18 colours for a label. The label’s mail keeps it until you remove it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE bietet diese 18 Farben für ein Label an. Die Mail des Labels behält die Farbe, bis Sie sie entfernen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для метки в EVE есть эти 18 цветов. Письма сохраняют метку, пока вы её не снимете."
          }
        }
      }
    },
    "EVE Online and the EVE logo are the registered trademarks of Fenris Creations (formerly CCP Games). Neocom is not affiliated with or endorsed by Fenris Creations." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE Online und das EVE-Logo sind eingetragene Marken von Fenris Creations (früher CCP Games). Neocom steht in keiner Verbindung zu Fenris Creations und wird von dort nicht unterstützt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE Online и логотип EVE — зарегистрированные товарные знаки Fenris Creations (ранее CCP Games). Neocom не связан с Fenris Creations и не одобрен ею."
          }
        }
      }
    },
    "EVE refreshes contracts every 5 minutes. An outstanding contract past its expiry stays listed until you remove it in the EVE client. Accept, complete or delete contracts in game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE aktualisiert Verträge alle 5 Minuten. Ein ausstehender Vertrag bleibt über sein Ablaufdatum hinaus aufgelistet, bis Sie ihn im EVE-Client entfernen. Verträge werden im Spiel angenommen, abgeschlossen oder gelöscht."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE обновляет контракты каждые 5 минут. Ожидающий контракт с истёкшим сроком остаётся в списке, пока вы не удалите его в клиенте EVE. Принимайте, выполняйте и удаляйте контракты в игре."
          }
        }
      }
    },
    "EVE refreshes the asset list about once an hour. Search finds an item in every hangar, ship and container." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE aktualisiert die Liste der Vermögenswerte etwa einmal pro Stunde. Die Suche findet einen Gegenstand in jedem Hangar, Schiff und Container."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE обновляет список имущества примерно раз в час. Поиск находит предметы во всех ангарах, кораблях и контейнерах."
          }
        }
      }
    },
    "EVE refreshes the corporation's orders every 20 minutes. Undercut and outbid are checked against the order book of the order’s region, once you have opened that market or the order. Change or cancel orders in the EVE client." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE aktualisiert die Aufträge der Corporation alle 20 Minuten. Unterbietung und Überbietung werden mit dem Orderbuch der Region des Auftrags abgeglichen, sobald Sie diesen Markt oder den Auftrag geöffnet haben. Aufträge im EVE-Client ändern oder stornieren."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE обновляет заявки корпорации каждые 20 минут. Перебитые цены и ставки проверяются по заявкам сектора, где выставлена заявка, — после того как вы откроете этот рынок или саму заявку. Изменить или отменить заявки можно в клиенте EVE."
          }
        }
      }
    },
    "EVE refreshes your orders every 20 minutes. Undercut and outbid are checked against the order book of the order’s region, once you have opened that market or the order. Change or cancel orders in the EVE client." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE aktualisiert Ihre Aufträge alle 20 Minuten. Unterbietung und Überbietung werden mit dem Orderbuch der Region des Auftrags abgeglichen, sobald Sie diesen Markt oder den Auftrag geöffnet haben. Aufträge im EVE-Client ändern oder stornieren."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE обновляет ваши заявки каждые 20 минут. Перебитые цены и ставки проверяются по заявкам сектора, где выставлена заявка, — после того как вы откроете этот рынок или саму заявку. Изменить или отменить заявки можно в клиенте EVE."
          }
        }
      }
    },
    "EVE refused the mail: %@ Your mail is kept as written — send it again when you are ready." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE hat die Mail abgelehnt: %@ Ihre Mail bleibt wie geschrieben erhalten – senden Sie sie erneut, wenn Sie bereit sind."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE отклонил письмо: %@ Текст сохранён как есть — отправьте его ещё раз, когда будете готовы."
          }
        }
      }
    },
    "EVE sends jobs every 5 minutes; progress is counted here against the clock. Deliver, pause or cancel a job in the EVE client." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE sendet Jobs alle 5 Minuten; der Fortschritt wird hier anhand der Uhr gezählt. Jobs im EVE-Client abliefern, pausieren oder abbrechen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE присылает работы каждые 5 минут; прогресс здесь считается по часам. Забрать результат, приостановить или отменить работу можно в клиенте EVE."
          }
        }
      }
    },
    "EVE sends mail 50 at a time, newest first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE sendet Mails in Paketen zu 50, neueste zuerst."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE передаёт письма по 50, сначала новые."
          }
        }
      }
    },
    "EVE sends mail 50 at a time, newest first. Swipe a mail to mark it read or delete it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE sendet Mails in Paketen zu 50, neueste zuerst. Wischen Sie über eine Mail, um sie als gelesen zu markieren oder zu löschen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE передаёт письма по 50, сначала новые. Смахните письмо, чтобы пометить его прочитанным или удалить."
          }
        }
      }
    },
    "EVE sends the asset list a page at a time. Neocom keeps it, so next time the list opens at once." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE sendet die Liste der Vermögenswerte seitenweise. Neocom speichert sie, sodass die Liste beim nächsten Mal sofort erscheint."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE передаёт список имущества постранично. Neocom сохраняет его, и в следующий раз список откроется сразу."
          }
        }
      }
    },
    "EVE SSO is not configured" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE SSO ist nicht konfiguriert"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE SSO не настроен"
          }
        }
      }
    },
    "EVE SSO is not configured. Put your application's Client ID into `SSOConfiguration.clientID`." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE SSO ist nicht konfiguriert. Tragen Sie die Client-ID Ihrer Anwendung in `SSOConfiguration.clientID` ein."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE SSO не настроен. Укажите Client ID вашего приложения в `SSOConfiguration.clientID`."
          }
        }
      }
    },
    "EVE SSO request failed with status %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE-SSO-Anfrage fehlgeschlagen, Status %lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошибка запроса EVE SSO, статус %lld."
          }
        }
      }
    },
    "EVE SSO returned a mismatched state parameter. The sign-in was aborted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE SSO hat einen abweichenden State-Parameter zurückgegeben. Die Anmeldung wurde abgebrochen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE SSO вернул несовпадающий параметр state. Вход прерван."
          }
        }
      }
    },
    "EVE SSO returned a token that could not be read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE SSO hat ein Token zurückgegeben, das nicht gelesen werden konnte."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE SSO вернул токен, который не удалось прочитать."
          }
        }
      }
    },
    "EVE SSO returned an unexpected callback." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE SSO hat einen unerwarteten Callback zurückgegeben."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE SSO вернул неожиданный ответ."
          }
        }
      }
    },
    "EVE takes at most %@ characters; links and line breaks count as more than one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE erlaubt höchstens %@ Zeichen; Links und Zeilenumbrüche zählen als mehr als ein Zeichen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE принимает не более %@ символов; ссылки и переносы строк считаются за несколько."
          }
        }
      }
    },
    "EVE takes the fee from your wallet only when the mail goes out. Nothing is charged without this approval." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE zieht die Gebühr erst von Ihrer Brieftasche ab, wenn die Mail versendet wird. Ohne diese Bestätigung wird nichts abgebucht."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE списывает сбор с кошелька только при отправке письма. Без этого подтверждения ничего не списывается."
          }
        }
      }
    },
    "EVE updated the asset list while it was being downloaded. Pull to refresh in a minute." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE hat die Vermögensliste während des Ladens aktualisiert. Ziehen Sie in einer Minute zum Aktualisieren."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE обновил список имущества во время загрузки. Через минуту потяните вниз, чтобы обновить."
          }
        }
      }
    },
    "EVE updates a colony only when you open it in the game client. Each colony is simulated from its last update to now; open it in game to refresh." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE aktualisiert eine Kolonie nur, wenn Sie sie im Spielclient öffnen. Jede Kolonie wird von ihrer letzten Aktualisierung bis jetzt simuliert; öffnen Sie sie im Spiel, um sie zu aktualisieren."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE обновляет колонию, только когда вы открываете её в клиенте игры. Каждая колония моделируется от последнего обновления до текущего момента; чтобы обновить, откройте её в игре."
          }
        }
      }
    },
    "EVE will not keep the following" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE wird Folgendes nicht behalten"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE не сохранит следующее"
          }
        }
      }
    },
    "Every item's price comes from it" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Preis jedes Gegenstands stammt daraus"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отсюда берутся цены всех предметов"
          }
        }
      }
    },
    "Every killmail in %@ is listed: a place has no kills or losses." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Killmails in %@ sind aufgelistet: Ein Ort hat keine Kills oder Verluste."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Место: %@. Показаны все киллмейлы — у места нет деления на уничтожения и потери."
          }
        }
      }
    },
    "Every level is trained. Nothing left to do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Stufen sind trainiert. Nichts mehr zu tun."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все уровни изучены. Больше делать нечего."
          }
        }
      }
    },
    "Every level trained. Nothing left to do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Stufen trainiert. Nichts mehr zu tun."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все уровни изучены. Больше делать нечего."
          }
        }
      }
    },
    "Every loaded mail in %@ is read." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle geladenen Mails in %@ sind gelesen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В «%@» все загруженные письма прочитаны."
          }
        }
      }
    },
    "Every pilot's training reminders are off." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Trainingserinnerungen aller Piloten sind aus."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Напоминания об обучении выключены у всех пилотов."
          }
        }
      }
    },
    "Every queue is paused: no skill has an end time yet." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Warteschlangen sind pausiert: Kein Skill hat bisher eine Endzeit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все очереди на паузе: ни у одного навыка ещё нет времени окончания."
          }
        }
      }
    },
    "Every storage stays under %@ %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Lager bleibt unter %1$@ %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Every storage stays under %1$@ %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все хранилища заполнены менее чем на %@ %@."
          }
        }
      }
    },
    "Everything after %@ is simulated from the colony's layout. Rates are averages from now to program end, %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles nach %1$@ wird aus dem Aufbau der Kolonie simuliert. Die Raten sind Durchschnittswerte von jetzt bis zum Programmende, %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Everything after %1$@ is simulated from the colony's layout. Rates are averages from now to program end, %2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё после %@ смоделировано по схеме колонии. Показатели — средние от текущего момента до конца программы, %@."
          }
        }
      }
    },
    "Everything after %@ is simulated from the colony's layout. Rates are averages over the next 24 hours." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles nach %@ wird aus dem Aufbau der Kolonie simuliert. Die Raten sind Durchschnittswerte der nächsten 24 Stunden."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё после %@ смоделировано по схеме колонии. Показатели — средние за следующие 24 часа."
          }
        }
      }
    },
    "Everything made has somewhere to go %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles Hergestellte hat bis %@ einen Platz."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всей продукции есть куда деваться %@."
          }
        }
      }
    },
    "EWAR" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EWAR"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "РЭБ"
          }
        }
      }
    },
    "Excluded" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeschlossen"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Исключены"
          }
        }
      }
    },
    "Exit Demo" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo beenden"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выйти из демо"
          }
        }
      }
    },
    "Exit Demo?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demo beenden?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выйти из демо?"
          }
        }
      }
    },
    "Exp" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Expl."
          }
        },
        "ru" : {
