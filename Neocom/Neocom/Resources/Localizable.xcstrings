          }
        }
      }
    },
    "EVE updates a colony only when you open it in the game client. Each colony is simulated from its last update to now; open it in game to refresh." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EVE обновляет колонию, только когда вы открываете её в клиенте игры. Каждая колония моделируется от последнего обновления до текущего момента; чтобы обновить, откройте её в игре."
          }
