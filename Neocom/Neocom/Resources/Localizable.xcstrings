    "Change or cancel the order in the EVE client." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ändern oder stornieren Sie den Auftrag im EVE-Client."
          }
        },
        "ru" : {
