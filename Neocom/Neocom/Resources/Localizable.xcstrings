    "Some items of this fitting are not in the database, are cargo or did not fit, and were left out." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Gegenstände dieses Fittings sind nicht in der Datenbank, sind Fracht oder passten nicht und wurden weggelassen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые предметы этой оснастки не найдены в базе данных, лежат в грузовом отсеке или не поместились — они пропущены."
          }
        }
      }
    },
    "Someone this mail is addressed to charges a fee to receive mail from pilots outside their contacts. EVE does not say who." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einer der Empfänger verlangt eine Gebühr für Mails von Piloten außerhalb seiner Kontakte. EVE nennt nicht, welcher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто-то из получателей берёт сбор за письма от пилотов, которых нет в его контактах. EVE не сообщает, кто именно."
          }
        }
      }
    },
