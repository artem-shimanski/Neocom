    "A bid at the buyout price ends the auction at once. Otherwise the highest bid wins when it expires." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Gebot zum Sofortkaufpreis beendet die Auktion sofort. Andernfalls gewinnt bei Ablauf das höchste Gebot."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставка по цене выкупа сразу завершает аукцион. Иначе по истечении срока побеждает самая высокая ставка."
          }
        }
      }
    },
    "A buyer at %@ pays %@ more. Raise your price in the EVE client to be first again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Käufer bei %1$@ zahlt %2$@ mehr. Erhöhen Sie Ihren Preis im EVE-Client, um wieder an erster Stelle zu stehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A buyer at %1$@ pays %2$@ more. Raise your price in the EVE client to be first again."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупатель (%@) платит на %@ больше. Поднимите цену в клиенте EVE, чтобы снова стать первым."
          }
        }
      }
    },
    "A charge does not fit its module: type %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Ladung passt nicht zu ihrem Modul: Typ %lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заряд не подходит к своему модулю: тип %lld."
          }
        }
      }
    },
    "A charge has no module in its slot: type %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Ladung hat kein Modul in ihrem Slot: Typ %lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У заряда нет модуля в разъёме: тип %lld."
          }
        }
      }
    },
    "A drone could not be saved: type %u." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Drohne konnte nicht gespeichert werden: Typ %u."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить дрона: тип %u."
          }
        }
      }
    },
    "A drone is added as a full stack of 5 and launched into space." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Drohne wird als vollständiger Stapel aus 5 hinzugefügt und in den Weltraum ausgesetzt."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дрон добавляется полной стопкой из 5 штук и выпускается в космос."
          }
        }
      }
    },
    "A drone stack of %lld was reduced to %u: type %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Drohnenstapel von %1$lld wurde auf %2$u verkleinert: Typ %3$lld."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "A drone stack of %1$lld was reduced to %2$u: type %3$lld."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стопка дронов уменьшена с %lld до %u: тип %lld."
          }
        }
      }
    },
    "A fighter is added as a full squadron and takes one slot of its type. It is launched into space while a fighter tube is free, and stays in the hangar otherwise." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Jäger wird als vollständige Staffel hinzugefügt und belegt einen Slot seines Typs. Er wird in den Weltraum gestartet, solange ein Jägerstartrohr frei ist, andernfalls bleibt er im Hangar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истребитель добавляется полной эскадрильей и занимает один слот своего типа. Он выпускается в космос, пока есть свободная шахта истребителей, иначе остаётся в ангаре."
          }
        }
      }
    },
    "A fitting in EVE cannot tell drones in space from drones in the bay." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fitting in EVE unterscheidet nicht zwischen Drohnen im Weltraum und im Drohnenhangar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оснастка в EVE не различает дронов в космосе и в отсеке."
          }
        }
      }
    },
    "A fitting in EVE holds one ship: %lld other pilots not saved." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
