    "The type catalog could not be loaded, so this fitting cannot be copied or opened." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Typkatalog konnte nicht geladen werden, daher kann dieses Fitting weder kopiert noch geöffnet werden."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить справочник типов, поэтому эту оснастку нельзя скопировать или открыть."
          }
        }
      }
    },
    "The wallet does not hold the fee. EVE takes it only when the mail goes out, so nothing has been charged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Guthaben in der Brieftasche reicht für die Gebühr nicht aus. EVE zieht sie erst beim Versand der Mail ein, daher wurde nichts abgebucht."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В кошельке не хватает на сбор. EVE списывает его только при отправке, поэтому ничего не списано."
          }
        }
      }
    },
    "The yield falls toward the end of the program." : {
