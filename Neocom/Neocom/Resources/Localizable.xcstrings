    "Yield" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добыча"
          }
        }
      }
    },
    "Yield per cycle" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добыча за цикл"
          }
        }
      }
    },
    "Yields come from the program set in game; the bars after now are the forecast. As of last update %@." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добыча берётся из программы, заданной в игре; столбцы после текущего момента — прогноз. Последнее обновление: %@."
          }
        }
      }
    },
    "You" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы"
          }
        }
      }
    },
