    "Register an application at developers.eveonline.com and put its Client ID into SSOConfiguration.clientID." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrieren Sie eine Anwendung auf developers.eveonline.com und tragen Sie deren Client-ID in SSOConfiguration.clientID ein."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зарегистрируйте приложение на developers.eveonline.com и укажите его Client ID в SSOConfiguration.clientID."
