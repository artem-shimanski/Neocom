    "Corporation assets need one more permission. Sign in to EVE again and allow Neocom to read your corporation's assets." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для имущества корпорации нужно ещё одно разрешение. Войдите в EVE ещё раз и разрешите Neocom читать имущество вашей корпорации."
          }
        }
      }
    },
    "Corporation contracts need one more permission. Sign in to EVE again and allow Neocom to read your corporation's contracts." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для контрактов корпорации нужно ещё одно разрешение. Войдите в EVE ещё раз и разрешите Neocom читать контракты вашей корпорации."
          }
        }
      }
    },
